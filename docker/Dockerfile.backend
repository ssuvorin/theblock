FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --home /app app
COPY backend/ ./
RUN pip install --no-cache-dir . && chown -R app:app /app

RUN printf '%s\n' \
      '#!/bin/sh' \
      '# Alembic owns the schema: a failed upgrade must abort the container, never serve stale.' \
      'set -eu' \
      'echo "backend: applying database migrations with alembic upgrade head"' \
      'alembic upgrade head' \
      'echo "backend: migrations applied, starting uvicorn"' \
      'exec uvicorn app.main:app --host 0.0.0.0 --port 8000' \
      > /usr/local/bin/start-backend \
    && chmod 0755 /usr/local/bin/start-backend

USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2)"
CMD ["/usr/local/bin/start-backend"]
