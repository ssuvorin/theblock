ENVIRONMENT=production
DATABASE_URL=<managed-postgresql-url>
PGBOUNCER_POOL_SIZE=<pool-size>
REDIS_URL=<managed-redis-url>

CONVEX_URL=https://<production-deployment>.convex.cloud
CONVEX_DEPLOY_KEY=<production-convex-deploy-key>

OPENROUTER_API_KEY=<production-openrouter-api-key>
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

GOOGLE_CLIENT_ID=<production-google-client-id>
GOOGLE_CLIENT_SECRET=<production-google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://<api-domain>/api/google/oauth/callback

EVOLUTION_API_URL=https://<authenticated-evolution-tunnel-domain>
EVOLUTION_API_KEY=<production-evolution-api-key>
EVOLUTION_WEBHOOK_SECRET=<production-evolution-webhook-secret>

COLLABUTE_MCP_URL=https://api.collabute.ai/api/mcp
COLLABUTE_OAUTH_REDIRECT_URI=https://<api-domain>/api/integrations/collabute/callback
CONTEXT_DEV_API_KEY=<production-context-dev-api-key>

CRM_AUTH_SECRET=<production-random-jwt-secret-min-32-chars>
ENCRYPTION_KEY=<production-base64-encoded-32-byte-key>
CRM_OWNER_EMAIL=<production-owner-email>
CRM_OWNER_PASSWORD=<production-owner-password-min-8-chars>
CRM_OWNER_DISPLAY_NAME=<production-owner-display-name>
CRM_COOKIE_SECURE=true
CRM_DEMO_MODE=false
CRM_SEED_DEMO_DATA=false
NEXT_PUBLIC_API_URL=https://<api-domain>
