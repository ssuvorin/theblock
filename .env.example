ENVIRONMENT=development
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
CRM_DATABASE_URL=postgresql+psycopg://<database-user>:<database-password>@localhost:6432/<database-name>
PGBOUNCER_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/0

CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_DEPLOY_KEY=<convex-deploy-key>

OPENROUTER_API_KEY=<openrouter-api-key>
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<evolution-api-key>
EVOLUTION_WEBHOOK_SECRET=<evolution-webhook-secret>

COLLABUTE_MCP_URL=https://api.collabute.ai/api/mcp
COLLABUTE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/collabute/callback
CONTEXT_DEV_API_KEY=<context-dev-api-key>

CRM_AUTH_SECRET=<random-jwt-secret-min-32-chars>
ENCRYPTION_KEY=<base64-encoded-32-byte-key>
CRM_OWNER_EMAIL=<owner-email>
CRM_OWNER_PASSWORD=<owner-password-min-8-chars>
CRM_OWNER_DISPLAY_NAME=<owner-display-name>
CRM_COOKIE_SECURE=false
CRM_DEMO_MODE=true
CRM_SEED_DEMO_DATA=true
NEXT_PUBLIC_API_URL=
